# WebFtp 环境配置
# 复制本文件为 .env 后按实际环境填写

# 服务端口
PORT=3000

# JWT 签名密钥（生产环境必须修改为随机长字符串）
JWT_SECRET=your-random-secret-key-here

# 主目录：程序(app)/数据(data)/文件(files) 三者的父级。
# 留空则取程序目录的上一级。例如 /opt/WebPan
# WEBPAN_ROOT=/opt/WebPan

# 磁盘保护：始终保留磁盘总量的该比例不参与写入，默认 0.05（5%），最大 0.5
# DISK_RESERVE_RATIO=0.05

# 垃圾清理：未完成上传的分片保留时长（小时），0 表示不清理，默认 24
# CHUNK_TTL_HOURS=24

# 垃圾清理：数据库无记录的孤儿文件保留时长（小时），0 表示不清理，默认 24
# ORPHAN_TTL_HOURS=24

# 垃圾清理执行间隔（分钟），默认 60
# GC_INTERVAL_MINUTES=60

# 单文件上传上限（MB），后台「系统配置」里的 upload_max_size 优先生效，默认 2048
# UPLOAD_MAX_SIZE_MB=2048
