<Page x:Class="WebFtpManager.Pages.StatsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F5F7FB"
      Loaded="Page_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="1100">
            <Grid Margin="0,0,0,12">
                <TextBlock Text="请求统计" FontSize="18" FontWeight="Bold" Foreground="#111827"/>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <CheckBox x:Name="AutoCb" Content="自动刷新 5s" VerticalContentAlignment="Center" IsChecked="True" Margin="0,0,12,0"/>
                    <Button x:Name="RefreshBtn" Content="刷新" Style="{StaticResource PrimaryButton}" Padding="12,6" Click="Refresh_Click"/>
                </StackPanel>
            </Grid>

            <!-- 关键指标卡片 -->
            <WrapPanel Margin="0,0,0,12">
                <Border Style="{StaticResource Card}" Width="220" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="最近 1 分钟请求" FontSize="11" Foreground="#6B7280"/>
                        <TextBlock x:Name="LastMinCount" Text="-" FontSize="28" FontWeight="Bold" Foreground="#4F46E5"/>
                        <TextBlock x:Name="LastMinDetail" Text="" FontSize="11" Foreground="#6B7280"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Width="220" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="最近 1 小时请求" FontSize="11" Foreground="#6B7280"/>
                        <TextBlock x:Name="LastHourCount" Text="-" FontSize="28" FontWeight="Bold" Foreground="#0EA5E9"/>
                        <TextBlock x:Name="LastHourDetail" Text="" FontSize="11" Foreground="#6B7280"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Width="220" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="服务运行时间" FontSize="11" Foreground="#6B7280"/>
                        <TextBlock x:Name="UptimeText" Text="-" FontSize="28" FontWeight="Bold" Foreground="#10B981"/>
                        <TextBlock x:Name="UptimeDetail" Text="" FontSize="11" Foreground="#6B7280"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- 趋势图：最近 60 分钟 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="最近 60 分钟请求量" FontSize="14" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,8"/>
                    <Canvas x:Name="MinuteCanvas" Height="160" Background="#FAFAFA" ClipToBounds="True"/>
                </StackPanel>
            </Border>

            <!-- 趋势图：最近 24 小时 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="最近 24 小时请求量" FontSize="14" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,8"/>
                    <Canvas x:Name="HourCanvas" Height="160" Background="#FAFAFA" ClipToBounds="True"/>
                </StackPanel>
            </Border>

            <!-- Top 路径 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Top 15 请求路径（最近 1 小时）" FontSize="14" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,8"/>
                    <DataGrid x:Name="TopGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              BorderThickness="0" MaxHeight="320" VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="*"/>
                            <DataGridTextColumn Header="次数" Binding="{Binding Count}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
