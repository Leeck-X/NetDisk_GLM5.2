<Page x:Class="WebFtpManager.Pages.ConfigPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F5F7FB"
      Loaded="Page_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="960">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="环境变量配置（.env）" FontSize="16" FontWeight="Bold" Foreground="#111827"/>
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button x:Name="ReloadBtn" Content="重新加载" Style="{StaticResource GhostButton}" Padding="10,4" Margin="0,0,8,0" Click="Reload_Click"/>
                            <Button x:Name="SaveBtn" Content="保存" Style="{StaticResource PrimaryButton}" Padding="14,6" Click="Save_Click"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="修改后请重启服务以生效。JWT_SECRET 留空则不修改。" FontSize="11" Foreground="#6B7280" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="PORT" VerticalAlignment="Center" FontFamily="Consolas" Foreground="#4338CA"/>
                        <TextBox Grid.Column="1" x:Name="PortBox" Margin="0,0,0,0" Padding="8,6"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="HOST" VerticalAlignment="Center" FontFamily="Consolas" Foreground="#4338CA"/>
                        <TextBox Grid.Column="1" x:Name="HostBox" Padding="8,6"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="JWT_SECRET" VerticalAlignment="Center" FontFamily="Consolas" Foreground="#4338CA"/>
                        <TextBox Grid.Column="1" x:Name="JwtBox" Padding="8,6" FontFamily="Consolas"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="原始 .env 内容（高级编辑）" FontSize="14" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,8"/>
                    <TextBox x:Name="RawBox" AcceptsReturn="True" TextWrapping="Wrap"
                             FontFamily="Consolas" FontSize="12"
                             MinHeight="240" VerticalScrollBarVisibility="Auto"
                             Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" Padding="10"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
