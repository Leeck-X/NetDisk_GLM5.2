<Page x:Class="WebFtpManager.Pages.UsersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F5F7FB"
      Loaded="Page_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="1100">
            <!-- 登录卡片 -->
            <Border x:Name="LoginCard" Style="{StaticResource Card}">
                <StackPanel MaxWidth="420" HorizontalAlignment="Stretch">
                    <TextBlock Text="管理员登录" FontSize="16" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,12"/>
                    <TextBlock Text="用户名" FontSize="12" Foreground="#374151" Margin="0,0,0,4"/>
                    <TextBox x:Name="UserBox" Padding="8,6" Margin="0,0,0,12"/>
                    <TextBlock Text="密码" FontSize="12" Foreground="#374151" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="PassBox" Padding="8,6" Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" x:Name="RememberCb" Content="记住凭据" VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1" x:Name="LoginBtn" Content="登录" Style="{StaticResource PrimaryButton}" Padding="20,6" Click="Login_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 用户列表 -->
            <Border x:Name="ListCard" Style="{StaticResource Card}" Visibility="Collapsed">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="用户管理" FontSize="16" FontWeight="Bold" Foreground="#111827"/>
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button x:Name="LogoutBtn" Content="退出登录" Style="{StaticResource GhostButton}" Padding="10,4" Margin="0,0,8,0" Click="Logout_Click"/>
                            <Button x:Name="CreateBtn" Content="+ 新建用户" Style="{StaticResource PrimaryButton}" Padding="14,6" Click="Create_Click"/>
                        </StackPanel>
                    </Grid>

                    <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6">
                        <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  BorderThickness="0" CanUserAddRows="False" CanUserDeleteRows="False"
                                  CanUserResizeRows="False" SelectionMode="Single"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  MaxHeight="500">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="用户名" Binding="{Binding Username}" Width="140"/>
                                <DataGridTextColumn Header="角色"   Binding="{Binding RoleText}" Width="100"/>
                                <DataGridTextColumn Header="已用/配额" Binding="{Binding QuotaText}" Width="*"/>
                                <DataGridTextColumn Header="状态"   Binding="{Binding StatusText}" Width="100"/>
                                <DataGridTextColumn Header="创建时间" Binding="{Binding CreatedAt}" Width="160"/>
                                <DataGridTemplateColumn Header="操作" Width="280">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="改密" Style="{StaticResource GhostButton}" Padding="10,4" Margin="0,0,4,0"
                                                        Click="ChangePass_Click" Tag="{Binding Id}"/>
                                                <Button Content="配额" Style="{StaticResource GhostButton}" Padding="10,4" Margin="0,0,4,0"
                                                        Click="Quota_Click" Tag="{Binding Id}"/>
                                                <Button Content="启用/禁用" Style="{StaticResource GhostButton}" Padding="10,4" Margin="0,0,4,0"
                                                        Click="ToggleEnabled_Click" Tag="{Binding Id}"/>
                                                <Button Content="删除" Style="{StaticResource DangerButton}" Padding="10,4"
                                                        Click="Delete_Click" Tag="{Binding Id}" IsEnabled="{Binding CanDelete}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
