<Page x:Class="WebFtpManager.Pages.SystemPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F5F7FB"
      Loaded="Page_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="960">
            <Grid Margin="0,0,0,12">
                <TextBlock Text="系统信息" FontSize="18" FontWeight="Bold" Foreground="#111827"/>
                <Button x:Name="RefreshBtn" HorizontalAlignment="Right" Content="刷新"
                        Style="{StaticResource PrimaryButton}" Padding="12,6" Click="Refresh_Click"/>
            </Grid>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="服务运行信息" FontSize="14" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,8"/>
                    <StackPanel x:Name="RuntimePanel"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="主机信息" FontSize="14" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,8"/>
                    <StackPanel x:Name="HostPanel"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="存储" FontSize="14" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,8"/>
                    <StackPanel x:Name="StoragePanel"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="垃圾清理与空间保护" FontSize="14" FontWeight="Bold" Foreground="#111827"/>
                        <Button x:Name="GcBtn" HorizontalAlignment="Right" Content="立即清理垃圾"
                                Style="{StaticResource PrimaryButton}" Padding="12,5" Click="Gc_Click"/>
                    </Grid>
                    <StackPanel x:Name="GcPanel"/>
                    <TextBlock x:Name="GcResultText" FontSize="12" Foreground="#374151" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="关键目录" FontSize="14" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,8"/>
                    <StackPanel x:Name="DirPanel"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
