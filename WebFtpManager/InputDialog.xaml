<Window x:Class="WebFtpManager.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入"
        Width="420" SizeToContent="Height"
        Background="#F5F7FB"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Border Background="#FFFFFF" Padding="20">
        <StackPanel>
            <TextBlock x:Name="Prompt" Text="" FontSize="14" Foreground="#111827" Margin="0,0,0,8"/>
            <StackPanel x:Name="FieldsPanel"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="CancelBtn" Content="取消" Style="{StaticResource GhostButton}" Padding="14,6" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button x:Name="OkBtn" Content="确定" Style="{StaticResource PrimaryButton}" Padding="14,6" Click="Ok_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
