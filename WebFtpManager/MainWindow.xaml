<Window x:Class="WebFtpManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WebFtp 服务管理器"
        Height="720" Width="1100"
        MinHeight="600" MinWidth="900"
        Background="#F5F7FB"
        WindowStartupLocation="CenterScreen"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Border Grid.Row="0" Background="#FFFFFF" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="8" Background="#6366F1" Margin="0,0,12,0">
                        <TextBlock Text="W" Foreground="White" FontSize="18" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="WebFtp Manager" FontSize="16" FontWeight="Bold" Foreground="#111827"/>
                        <TextBlock Text="自托管网盘 · 服务管理面板" FontSize="11" Foreground="#6B7280"/>
                    </StackPanel>
                </StackPanel>

                <!-- Tab 切换 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="TabService" Content="服务" Style="{StaticResource TabButton}" Tag="Active" Click="Tab_Click"/>
                    <Button x:Name="TabStats" Content="统计" Style="{StaticResource TabButton}" Margin="6,0,0,0" Click="Tab_Click"/>
                    <Button x:Name="TabUsers" Content="用户" Style="{StaticResource TabButton}" Margin="6,0,0,0" Click="Tab_Click"/>
                    <Button x:Name="TabLogs" Content="日志" Style="{StaticResource TabButton}" Margin="6,0,0,0" Click="Tab_Click"/>
                    <Button x:Name="TabConfig" Content="配置" Style="{StaticResource TabButton}" Margin="6,0,0,0" Click="Tab_Click"/>
                    <Button x:Name="TabSystem" Content="系统" Style="{StaticResource TabButton}" Margin="6,0,0,0" Click="Tab_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="OpenWebBtn" Content="打开 Web" Style="{StaticResource GhostButton}" Click="OpenWeb_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 内容区 -->
        <Frame Grid.Row="1" x:Name="ContentFrame" NavigationUIVisibility="Hidden" JournalOwnership="OwnsJournal"/>

        <!-- 状态栏 -->
        <Border Grid.Row="2" Background="#FFFFFF" Padding="20,8" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#9CA3AF" Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusText" Text="未检测" FontSize="12" Foreground="#374151" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusDetail" Text="" FontSize="12" Foreground="#6B7280" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="v1.0.0" FontSize="11" Foreground="#9CA3AF" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
